---
const ctas = [
  { label: "View showcase", href: "/showcase/", primary: true },
  { label: "Resume", href: "/resume/" },
  { label: "All projects", href: "/projects/" },
];
---

<section class="relative overflow-hidden border-b border-slate-800">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(16,185,129,0.12),_transparent_60%)]"
  >
  </div>
  <div class="relative mx-auto flex w-full max-w-4xl flex-col gap-6 px-6 py-20">
    <h1 class="text-4xl font-bold tracking-tight text-slate-50 sm:text-5xl">Curtis Heisner</h1>
    <p class="max-w-2xl text-lg text-slate-400">
      Software Engineer in Test — I build the platforms, AI tooling, and infrastructure that
      make testing actually work, not just the test scripts on top of them.
    </p>
    <nav class="flex flex-wrap gap-4 pt-2">
      {ctas.map((cta) => (
        <a
          href={cta.href}
          class:list={[
            "rounded-md border px-4 py-2 text-sm font-medium transition",
            cta.primary
              ? "border-emerald-500 bg-emerald-500/10 text-emerald-300 hover:bg-emerald-500/20"
              : "border-slate-700 text-slate-200 hover:border-emerald-500 hover:text-emerald-400",
          ]}
        >
          {cta.label}
        </a>
      ))}
    </nav>
  </div>
</section>
