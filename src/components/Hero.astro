---
const links = [
  { label: "GitHub", href: "https://github.com/cmheisner" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/curtis-heisner-89443287" },
  { label: "Email", href: "mailto:curtis.heisner.88@gmail.com" },
];
---

<header class="relative overflow-hidden border-b border-slate-800">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(16,185,129,0.12),_transparent_60%)]"
  >
  </div>
  <div class="relative mx-auto flex w-full max-w-4xl flex-col gap-6 px-6 py-24">
    <p class="font-mono text-sm text-emerald-400">curtis@heisner:~$</p>
    <h1 class="text-4xl font-bold tracking-tight text-slate-50 sm:text-5xl">Curtis Heisner</h1>
    <p class="max-w-2xl text-lg text-slate-400">
      Software Engineer in Test — I build the platforms, AI tooling, and infrastructure that
      make testing actually work, not just the test scripts on top of them.
    </p>
    <nav class="flex flex-wrap gap-4 pt-2">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noreferrer" : undefined}
          class="rounded-md border border-slate-700 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-emerald-500 hover:text-emerald-400"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
