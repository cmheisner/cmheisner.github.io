---
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
}

const { id, title, eyebrow } = Astro.props;
---

<section id={id} class="mx-auto w-full max-w-4xl px-6 py-16 scroll-mt-20">
  {eyebrow && (
    <p class="mb-2 font-mono text-sm uppercase tracking-widest text-emerald-400">{eyebrow}</p>
  )}
  <h2 class="mb-8 text-2xl font-semibold text-slate-100 sm:text-3xl">{title}</h2>
  <slot />
</section>
