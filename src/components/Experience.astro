---
import Section from "./Section.astro";
import { roles } from "../data/resume";
---

<Section id="experience" title="Experience">
  <div class="space-y-10">
    {roles.map((role) => (
      <article>
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <h3 class="text-lg font-semibold text-slate-100">{role.title}</h3>
          <span class="font-mono text-sm text-slate-500">{role.period}</span>
        </div>
        <p class="text-sm text-emerald-400">{role.org}</p>
        <p class="mt-3 text-slate-300">{role.summary}</p>
        <ul class="mt-4 space-y-2 text-slate-300">
          {role.highlights.map((h) => (
            <li class="flex gap-3">
              <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-emerald-500"></span>
              <span>{h}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</Section>
