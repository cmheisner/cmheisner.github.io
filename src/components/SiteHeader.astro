---
const links = [
  { label: "Resume", href: "/resume/" },
  { label: "Projects", href: "/projects/" },
  { label: "Showcase", href: "/showcase/" },
];

const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isActive = (href: string) => path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-slate-800 bg-slate-950/85 backdrop-blur">
  <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-3">
    <a href="/" class="font-mono text-sm text-emerald-400 hover:text-emerald-300">curtis@heisner:~$</a>
    <nav class="flex flex-wrap gap-1">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class:list={[
            "rounded-md px-3 py-1.5 text-sm font-medium transition",
            isActive(link.href)
              ? "bg-slate-800 text-emerald-400"
              : "text-slate-300 hover:bg-slate-900 hover:text-emerald-400",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
