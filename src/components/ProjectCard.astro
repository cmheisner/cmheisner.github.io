---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const Tag = project.url ? "a" : "div";
---

<Tag
  href={project.url}
  target={project.url ? "_blank" : undefined}
  rel={project.url ? "noreferrer" : undefined}
  class:list={[
    "group flex h-full flex-col rounded-lg border border-slate-800 bg-slate-900/50 p-5 transition",
    project.url && "hover:border-emerald-500/60 hover:bg-slate-900",
  ]}
>
  <div class="flex items-start justify-between gap-2">
    <h3 class="font-semibold text-slate-100 group-hover:text-emerald-400">{project.name}</h3>
    {project.status && (
      <span class="flex-shrink-0 rounded-full border border-slate-700 px-2 py-0.5 text-xs text-slate-400">
        {project.status}
      </span>
    )}
  </div>
  <p class="mt-2 flex-1 text-sm text-slate-400">{project.description}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {project.tags.map((tag) => (
      <span class="rounded bg-slate-800 px-2 py-0.5 text-xs text-slate-400">{tag}</span>
    ))}
  </div>
  {project.url && (
    <span class="mt-3 text-xs font-mono text-slate-500 group-hover:text-emerald-500">
      view on github →
    </span>
  )}
</Tag>
