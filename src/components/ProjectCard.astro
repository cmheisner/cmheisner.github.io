---
import type { Project } from "../data/projects";
import { getScreenshots } from "../data/screenshots";
import PreviewImage from "./PreviewImage.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const hasCover = getScreenshots(project).length > 0;
---

<div
  class="group relative flex h-full flex-col overflow-hidden rounded-lg border border-slate-800 bg-slate-900/50 transition hover:border-emerald-500/60 hover:bg-slate-900"
>
  {hasCover && <PreviewImage project={project} class="border-b border-slate-800" />}
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-semibold text-slate-100 group-hover:text-emerald-400">
        <a href={`/projects/${project.slug}/`} class="after:absolute after:inset-0">{project.name}</a>
      </h3>
      {project.status && (
        <span class="flex-shrink-0 rounded-full border border-slate-700 px-2 py-0.5 text-xs text-slate-400">
          {project.status}
        </span>
      )}
    </div>
    <p class="mt-2 flex-1 text-sm text-slate-400">{project.description}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {project.tags.map((tag) => (
        <span class="rounded bg-slate-800 px-2 py-0.5 text-xs text-slate-400">{tag}</span>
      ))}
    </div>
    {project.url && (
      <a
        href={project.url}
        target="_blank"
        rel="noreferrer"
        class="relative z-10 mt-3 self-start font-mono text-xs text-slate-500 hover:text-emerald-500"
      >
        view on github →
      </a>
    )}
  </div>
</div>
