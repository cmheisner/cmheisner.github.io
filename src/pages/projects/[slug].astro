---
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PreviewImage from "../../components/PreviewImage.astro";
import { projects, type Project } from "../../data/projects";
import { getScreenshots } from "../../data/screenshots";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const shots = getScreenshots(project);
const fullSize = await Promise.all(shots.map((s) => getImage({ src: s.image, width: 1920 })));
const ogImage = shots[0] ? (await getImage({ src: shots[0].image, width: 1200, format: "png" })).src : undefined;
---

<Layout title={`${project.name} — Curtis Heisner`} description={project.description} image={ogImage}>
  <article class="mx-auto w-full max-w-4xl px-6 py-16">
    <a href="/projects/" class="font-mono text-sm text-slate-500 hover:text-emerald-400">← all projects</a>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-bold tracking-tight text-slate-50 sm:text-4xl">{project.name}</h1>
      {project.status && (
        <span class="rounded-full border border-slate-700 px-2 py-0.5 text-xs text-slate-400">{project.status}</span>
      )}
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      {project.tags.map((tag) => (
        <span class="rounded bg-slate-800 px-2 py-0.5 text-xs text-slate-400">{tag}</span>
      ))}
    </div>

    <p class="mt-6 max-w-2xl text-lg text-slate-300">{project.description}</p>
    {project.details && <p class="mt-4 max-w-2xl whitespace-pre-line text-slate-400">{project.details}</p>}

    {(project.demoUrl || project.url) && (
      <div class="mt-8 flex flex-wrap gap-4">
        {project.demoUrl && (
          <a
            href={project.demoUrl}
            target="_blank"
            rel="noreferrer"
            class="rounded-md border border-emerald-500 bg-emerald-500/10 px-4 py-2 text-sm font-medium text-emerald-300 transition hover:bg-emerald-500/20"
          >
            Try the live demo ↗
          </a>
        )}
        {project.url && (
          <a
            href={project.url}
            target="_blank"
            rel="noreferrer"
            class="rounded-md border border-slate-700 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-emerald-500 hover:text-emerald-400"
          >
            View on GitHub ↗
          </a>
        )}
      </div>
    )}

    <section class="mt-12">
      {shots.length > 0 ? (
        <div class="grid gap-4 sm:grid-cols-2">
          {shots.map((shot, i) => (
            <figure class:list={[i === 0 && shots.length > 1 && "sm:col-span-2"]}>
              <button
                type="button"
                data-full={fullSize[i].src}
                data-alt={shot.alt}
                class="group block w-full cursor-zoom-in overflow-hidden rounded-lg border border-slate-800 hover:border-emerald-500/60"
              >
                <Image
                  src={shot.image}
                  alt={shot.alt}
                  widths={[480, 960, 1440]}
                  sizes={i === 0 ? "(min-width: 896px) 832px, 100vw" : "(min-width: 896px) 408px, 100vw"}
                  class="w-full transition duration-300 group-hover:scale-[1.02]"
                />
              </button>
              {shot.caption && <figcaption class="mt-2 text-sm text-slate-500">{shot.caption}</figcaption>}
            </figure>
          ))}
        </div>
      ) : (
        <PreviewImage project={project} class="rounded-lg border border-slate-800" />
      )}
    </section>
  </article>

  <dialog
    id="lightbox"
    class="m-auto max-h-[90vh] max-w-[95vw] cursor-zoom-out bg-transparent p-0 backdrop:bg-black/85"
  >
    <img id="lightbox-img" class="max-h-[90vh] max-w-[95vw] rounded-lg" alt="" />
  </dialog>
</Layout>

<script>
  const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;
  const img = document.getElementById("lightbox-img") as HTMLImageElement | null;
  document.querySelectorAll<HTMLButtonElement>("[data-full]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!dialog || !img) return;
      img.src = button.dataset.full ?? "";
      img.alt = button.dataset.alt ?? "";
      dialog.showModal();
    });
  });
  dialog?.addEventListener("click", () => dialog.close());
</script>
